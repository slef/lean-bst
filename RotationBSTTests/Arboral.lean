-- Boundary points count. Adding an arbitrary point need not preserve ASS.
example : ASS {(0, 0), (2, 0), (2, 2)} := by decide
example : ¬ ASS {(0, 0), (2, 0), (2, 2), (1, 1)} := by decide
example : ¬ ASS {(0, 0), (2, 2)} := by decide
example : ASS {(0, 0), (0, 1), (0, 2)} := by decide

-- First access, repeated access, and projection from both sides.
example : greedySweep 0 1 ∅ = {1} := by decide
example : greedySweep 1 1 {(1, 0)} = {1} := by decide
example : greedySweep 1 3 {(1, 0)} = {1, 3} := by decide
example : greedySweep 2 2 {(1, 0), (1, 1), (3, 1)} = {1, 2, 3} := by decide

-- The independent exhaustive implementation agrees with the sweep.
example : greedy 4 2 2 {(1, 0), (1, 1), (3, 1)} = {1, 2, 3} := by decide
example : rowCost greedySweep 0 ∅ [1, 3, 2] = 6 := by decide
example : (fill greedySweep 0 ∅ [1, 3, 2]).card = 6 := by decide
example : ASS (fill greedySweep 0 ∅ [1, 3, 2]) := by decide
example : keysAt (fill greedySweep 0 ∅ [1, 3, 2]) 1 = {1, 3} := by decide
example : scheduleCost (fill greedySweep 0 ∅ [1, 3, 2]) 3 = 6 := by decide
example : rowCost greedySweep 0 ∅ [1, 1, 1] = 3 := by decide

-- A first observation is not a switch. The reference node itself is left.
example : Wilber.interleave (Tango.perfect 2) [0, 2, 0, 2] = 3 := by decide
example : Wilber.interleave (Tango.perfect 2) [2, 1, 2] = 2 := by decide
example : Wilber.interleave (Tango.perfect 2) [1, 1, 1] = 0 := by decide
example : Tango.changeCost (Tango.perfect 2) [] [0, 2, 0, 2] = 3 := by decide
example : (Tango.perfect 3).size = 7 := by decide
example : Tango.height (Tango.perfect 3) = 3 := by decide

-- The geometric output can be realized by real rotations from a prescribed tree.
-- This realization is offline, even though its point set is generated by GreedyASS.
example (s : Tree) (xs : List Nat) (valid : ∀ x ∈ xs, x < s.size) :
    ∃ t r, RotationBST.Execution s xs t r ∧ xs.length + r ≤
      2 * s.size + 99 * rowCost greedySweep 0 ∅ xs := by
  obtain ⟨E, _, hc⟩ := Geometric.Results.online_solution (Geometric.greedyASS s.size) xs valid
  obtain ⟨t, r, execution, cost⟩ := Geometric.Equivalence.Results.ass_to_rotations s xs E
  exact ⟨t, r, execution, by simpa only [hc, Geometric.greedyASS] using cost⟩

-- Exact cardinality, including the zero-request and unused-key cases.
example (n : Nat) : ∃ s t, s.size = n ∧ RegionExecution s [] t 0 := by
  apply (Geometric.Equivalence.Results.ass_iff_region_execution n [] 0).mp
  exact ⟨⟨⟨∅, by simp [requestsAt], ass_empty⟩, by simp [History]⟩, rfl⟩

example : Tango.preferenceChanges (Tango.perfect 2) [0, 2, 0, 2] = 6 := by decide
example : Wilber.transitionKeys (Tango.perfect 2) 0 (Tango.perfect 2) = [2] := by decide
example : Wilber.transitionKeys (Tango.perfect 3) 0 (Tango.perfect 3) = [5, 2, 6] := by decide
example (reference : Tree) (xs : List Nat) (E : Offline reference.size xs) :
    Wilber.interleave reference xs ≤ 2 * E.points.card :=
  Wilber.Results.interleave_lower_bound reference rfl E

example : Tango.preferredPaths (Tango.perfect 2) [] = [[1], [0], [2]] := by decide
example : Tango.preferredPaths (Tango.perfect 2) [0] = [[1, 0], [2]] := by decide
example : Tango.preferredPaths (Tango.perfect 2) [0, 2] = [[1, 2], [0]] := by decide
example : Tango.preferredPaths (Tango.perfect 3) [0] = [[3, 1, 0], [2], [5], [4], [6]] := by decide

namespace Auxiliary
open Pointer.Lazy.Skeleton Region

-- Fringe sizes alter global ranks, but not auxiliary splay shapes or costs.
private def sample (a b c d : Tree) : Region :=
  .node (.node (.hole a) (.hole b)) (.node (.hole c) (.hole d))

example (a b c d : Tree) :
    (auxiliaryRun (sample a b c d) 0).1.tree =
      .node a (.node b (.node c d)) := by rfl

example (a b c d : Tree) : (auxiliaryRun (sample a b c d) 0).2 = 1 := by rfl
example (a b c d : Tree) : (auxiliaryRun (sample a b c d) 2).2 = 1 := by rfl

example (a b c d : Tree) :
    (auxiliaryRun (sample a b c d) 2).1.fringe = [a, b, c, d] := by rfl

example : index (sample (Tango.perfect 3) .nil .nil .nil) 0 7 = 0 := by decide
example : (auxiliaryRun (sample (Tango.perfect 3) .nil .nil .nil) 0).1.tree.size = 10 := by decide

-- Check the public theorem on a global rank distinct from its auxiliary rank.
example : Access (sample (Tango.perfect 3) .nil .nil .nil).tree
    (auxiliaryRun (sample (Tango.perfect 3) .nil .nil .nil) 0).1.tree 7 1 := by
  have h := Tango.Auxiliary.Results.access (sample (Tango.perfect 3) .nil .nil .nil) 7 (by decide)
  exact h.2.1

end Auxiliary

namespace MarkedState
open Tango Tango.MarkedTree

private def leaf : MarkedTree := .node .nil .nil true true
private def before : MarkedTree := .node leaf leaf false true
private def after : MarkedTree := .node .nil (.node .nil leaf true true) true false

-- One preferred path plus an attached singleton, with absolute global ranks.
example : before.region.size = 2 ∧ before.tree.size = 3 := by decide
example : (before.components 0).map (fun p => p.2.keys p.1) = [{0, 1}, {2}] := by decide
example : Represents before (perfect 2) [0] := by unfold Represents; decide
example : before.fringe = after.fringe := by decide
example : Rotate before.tree after.tree := .right
example : Represents after (perfect 2) [0] :=
  represents_of_fringe (by unfold Represents; decide : Represents before (perfect 2) [0]) (by decide)

-- Marks on empty edges do not introduce empty components.
example : ((MarkedTree.node .nil .nil false false).components 0).length = 1 := by decide
example : ((initial (perfect 2)).components 0).map (fun p => p.2.keys p.1) = [{1}, {0}, {2}] := by decide
example : (initial (perfect 3)).potential = 0 := initial_potential _

-- The public access bound accounts for the entire marked state.
example : ∃ u : MarkedTree, ∃ cost : Nat,
    Access before.tree u.tree 0 cost ∧ Represents u (perfect 2) [0] ∧
      (cost : ℝ) + u.potential - before.potential ≤ 3 * Real.logb 2 (height (perfect 2)) + 1 :=
  State.Results.access before (perfect 2) [0] (by unfold Represents; decide) 0 (by decide)

end MarkedState

