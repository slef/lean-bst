namespace MarkedState
open Tango Tango.MarkedTree

example : before.nesting.span = 4 := by rw [nesting_span]; decide
example : before.nesting = after.nesting := nesting_of_fringe (by decide)

-- The same lower component is reached through different auxiliary shapes.
example : Maintains after (perfect 2) [0] := by
  apply maintains_of_fringe (s := before) _ (by decide)
  exact ⟨by unfold Represents; decide, rfl⟩

example : ∃ child : MarkedTree, ∃ fs : List Context.Frame,
    (2, child) ∈ after.fringeAt 0 ∧ child.nesting = leaf.nesting ∧
      fs ≠ [] ∧ Context.Boundary fs ∧ Context.plug fs child = after := by
  apply State.Nesting.Results.locate after (perfect 2) [0] (p := (2, leaf))
  · apply maintains_of_fringe (s := before) _ (by decide)
    exact ⟨by unfold Represents; decide, rfl⟩
  · decide
  · intro h; cases h

-- Nesting alone recovers the full preferred-path partition.
example : Maintains after (perfect 2) [0] :=
  (State.Nesting.Results.maintenance_iff after (perfect 2) [0]).2
    (nesting_of_fringe (s := before) (by decide)).symm

-- Equal leaf shapes at distinct positions must yield different context offsets.
example (lo : Nat) :
    ∃ fs : List Context.Frame, fs ≠ [] ∧ Context.Boundary fs ∧
      Context.plug fs leaf = MarkedTree.node leaf leaf true true ∧
      Context.offset fs lo = lo + leaf.tree.size + 1 := by
  apply Context.locate_fringeAt (.node leaf leaf true true) lo leaf _
  · simp [fringeAt]
  · intro h; cases h

-- An unmarked ancestor above a marked boundary does not alter local potential cost.
example (s t sibling outer : MarkedTree) :
    (Context.plug [.left sibling true false, .right outer false true] t).potential -
      (Context.plug [.left sibling true false, .right outer false true] s).potential =
        t.potential - s.potential := Context.Results.potential_change [.left sibling true false, .right outer false true] rfl s t

end MarkedState

namespace NestingEdits
open Tango Tango.MarkedTree

private def leaf : MarkedTree := .node .nil .nil true true
private def allActive : MarkedTree := .node leaf leaf false false

-- The interior key becomes its own component, retaining both outside keys.
example : allActive.nesting.group 1 2 =
    .branch [.empty, .branch [.empty, .empty], .empty] := rfl
example : (allActive.nesting.group 1 2).merge 1 = allActive.nesting := rfl
example : ∃ t : MarkedTree, ∃ cost : Nat,
    t.nesting = allActive.nesting.group 1 2 ∧ Rotations allActive.tree t.tree cost ∧
      (cost : ℝ) + t.potential - allActive.potential ≤ 6 * Real.logb 2 allActive.region.size + 2 := by
  simpa only [Nat.reduceSub, Nat.reduceAdd] using
    State.Edits.Results.simulate_cut allActive allActive rfl 1 2 (by decide) (by decide) (by decide)

-- A preferred-edge switch is realized even with an empty old preferred child.
example (s r : MarkedTree) (same : s.nesting = (MarkedTree.node .nil r false true).nesting) :
    ∃ t : MarkedTree, ∃ cost : Nat,
      t.nesting = (MarkedTree.node .nil r true false).nesting ∧ Rotations s.tree t.tree cost ∧
      (cost : ℝ) + t.potential - s.potential ≤ 14 * Real.logb 2 (r.region.size + 1 : Nat) + 4 := by
  simpa only [region, Pointer.Lazy.Skeleton.size, Nat.zero_add] using
    State.Edits.Results.switch_right s .nil r same

end NestingEdits

namespace NestingEdits
open Tango Tango.MarkedTree

private def ancestor : Context.Frame := .left leaf false true
private def deepBefore : MarkedTree := Context.plug [ancestor] (.node leaf leaf false true)
private def deepAfter : MarkedTree := Context.plug [ancestor] (.node leaf leaf true false)

-- A switch below an unmarked ancestor uses the whole component's size bound.
example : deepBefore.region.size = 3 ∧ deepAfter.region.size = 3 := by decide
example : ∃ t : MarkedTree, ∃ cost : Nat,
    t.nesting = deepAfter.nesting ∧ Rotations deepBefore.tree t.tree cost ∧
      (cost : ℝ) + t.potential - deepBefore.potential ≤ 14 * Real.logb 2 3 + 4 := by
  exact State.PathEdits.Results.switch_in_path_bound [ancestor]
    (by simp [ancestor, Context.Frame.marked]) deepBefore leaf leaf true 3 rfl (by decide) (by decide)

-- Crossing several marked boundaries adds no reference-depth factor.
private def outer : List Context.Frame :=
  [.left leaf true false, .right leaf false true, .right leaf true true]

example (s : MarkedTree) (same : s.nesting = (Context.plug outer deepBefore).nesting) :
    ∃ t : MarkedTree, ∃ cost : Nat,
      t.nesting = (Context.plug outer deepAfter).nesting ∧ Rotations s.tree t.tree cost ∧
      (cost : ℝ) + t.potential - s.potential ≤ 14 * Real.logb 2 3 + 4 := by
  exact State.WholeEdits.Results.switch_in_component outer rfl [ancestor]
    (by simp [ancestor, Context.Frame.marked]) s leaf leaf true 3 same (by decide) (by decide)

-- First-time preferences also embed under the same arbitrary outer context.
example (s : MarkedTree)
    (same : s.nesting = (Context.plug outer (.node leaf leaf true true)).nesting) :
    ∃ t : MarkedTree, ∃ cost : Nat,
      t.nesting = (Context.plug outer (.node leaf leaf false true)).nesting ∧
      Rotations s.tree t.tree cost ∧
      (cost : ℝ) + t.potential - s.potential ≤ 8 * Real.logb 2 2 + 2 := by
  exact State.WholeEdits.Results.unmark_in_component outer rfl [] (by simp)
    (.left leaf true true) leaf s same

end NestingEdits

namespace PreferenceRealization
open Tango Tango.MarkedTree

private def reference : MarkedTree := initial (perfect 3)
private def updates : List PreferenceUpdate := [⟨3, none, true⟩, ⟨1, none, false⟩]

-- A root-to-descendant log changes the specified ranks, preserving all tree keys.
example : (reference.applyPreferences updates).tree = (perfect 3) := by decide
example : (reference.applyPreferences updates).PathMarked := by
  exact applyPreferences_pathMarked reference updates
    (by simpa only [reference, canonical_initial] using canonical_pathMarked (perfect 3) 0 [])
example : (reference.applyPreferences updates).region.size = 3 := by decide

-- Intermediate component growth is covered by the fixed reference-height bound.
example : ∃ result : MarkedTree, ∃ cost : Nat,
    result.nesting = (reference.applyPreferences updates).nesting ∧
    Rotations reference.tree result.tree cost ∧
    (cost : ℝ) + result.potential - reference.potential ≤ 2 * (14 * Real.logb 2 3 + 4) := by
  apply State.Preferences.Results.update_sequence reference reference updates rfl
  · simpa only [reference, canonical_initial] using canonical_pathMarked (perfect 3) 0 []
  · intro update member
    simp only [updates, List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl | rfl <;> decide

-- An out-of-range reference rank leaves the marking alone.
example : reference.setPreference 7 false = reference := by decide

end PreferenceRealization

namespace TangoRequests
open Tango Tango.MarkedTree

-- The executable log handles first settings, switches, root requests, and repeats.
example : (initial (perfect 3)).applyPreferences (preferenceLog (perfect 3) [] [0, 6, 3, 2, 2]) =
    canonical (perfect 3) 0 [0, 6, 3, 2, 2] := by decide

-- One policy is fixed before either the input or the offline comparator is chosen.
example (h : Nat) : ∃ p : Policy (perfect h),
    ∀ (xs : List Nat) (finish : Tree) (offline : Nat),
      Execution (perfect h) xs finish offline →
      ((p.run xs).2 : ℝ) + xs.length ≤
        (56 * Real.logb 2 h + 16) * (offline + xs.length : Nat) +
          (14 * Real.logb 2 h + 4) * (2 ^ h - 1 : Nat) := by
  obtain ⟨p⟩ := Tango.Algorithm.Results.policy_exists (perfect h)
  exact ⟨p, fun _ _ _ execution => Tango.Algorithm.Results.perfect_competitive h p rfl execution⟩

example (p : Policy (perfect 3)) :
    Execution (perfect 3) [0, 6, 3, 2, 2] (p.run [0, 6, 3, 2, 2]).1.tree (p.run [0, 6, 3, 2, 2]).2 := by
  exact (Tango.Algorithm.Results.execution p _ (by intro x hx; simp_all [perfect, Tree.size]; omega)).1

end TangoRequests

namespace BalancedTango
open Tango

-- Empty, singleton, and power-of-two boundary cases use no padding keys.
example : balanced 0 = .nil ∧ (balanced 1).size = 1 := by norm_num [balanced.eq_def, Tree.size]
example : height (balanced 7) = 3 ∧ height (balanced 8) = 4 ∧ (balanced 8).size = 8 := by
  norm_num [balanced.eq_def, height, Tree.size]

-- A non-perfect universe has the same competitive theorem with log-height 3.
example : ∃ p : Policy (balanced 6),
    ∀ (xs : List Nat) (finish : Tree) (offline : Nat),
      Execution (balanced 6) xs finish offline →
      ((p.run xs).2 : ℝ) + xs.length ≤
        (56 * Real.logb 2 3 + 16) * (offline + xs.length : Nat) +
          (14 * Real.logb 2 3 + 4) * 6 := by
  obtain ⟨p⟩ := Tango.Algorithm.Results.policy_exists (balanced 6)
  refine ⟨p, ?_⟩
  intro xs finish offline execution
  convert Tango.Algorithm.Results.balanced_competitive 6 p (balanced_size 6) execution using 1; norm_num

end BalancedTango

