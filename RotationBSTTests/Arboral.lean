open RotationBST.SplitTree Multiway.Finger

private def leaf : Multiway := .two .nil .nil
private def three : Multiway := .two leaf leaf
private def wide : Multiway := .four .nil .nil .nil .nil
private def full : Multiway := .four wide wide wide wide
private def uneven : TwoEnded.State := ⟨⟨three, 2⟩, ⟨full, 2⟩⟩
private theorem valid : uneven.HeightValid :=
  ⟨.two (.two .nil .nil) (.two .nil .nil),
    .four (.four .nil .nil .nil .nil) (.four .nil .nil .nil .nil)
      (.four .nil .nil .nil .nil) (.four .nil .nil .nil .nil), by decide, by decide⟩

-- Equal heights suffice despite a large size imbalance; no rebuild is needed.
example : uneven.left.tree.size = 3 ∧ uneven.right.tree.size = 15 := by decide
example : TwoEnded.chosenDistance uneven 4 = 14 := by decide
example : TwoEnded.rebalance uneven = (uneven, 0) := TwoEnded.rebalance_unchanged valid
example : Nat.log2 (TwoEnded.chosenDistance uneven 4 + 1) ≤
    2 * Nat.log2 (min 4 (uneven.size - 1 - 4) + 1) + 2 :=
  TwoEnded.Height.Results.endpoint_choice valid 4 (by decide)

-- An actual two-level height gap is repaired in the existing shared BST.
private def short : TwoEnded.State := ⟨⟨.nil, 0⟩, ⟨three, 2⟩⟩
example : (TwoEnded.rebalance short).2 = 4 := by decide
example : (TwoEnded.rebalance short).1.size = 4 := by decide
example : (TwoEnded.rebalance short).1.HeightValid :=
  (TwoEnded.Height.Results.restore short .nil (.two (.two .nil .nil) (.two .nil .nil))).1

end HeightBalancedEndpoints
