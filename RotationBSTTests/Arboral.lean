private def chain : Tree := .node .nil (.node .nil (.node .nil .nil))
private def misplaced : MarkedTree := initial (.node chain (perfect 2))

-- Matching all singleton key sets and the root path does not fix lower nesting.
example : Represents misplaced (perfect 3) [] := by unfold Represents; decide
example : ¬ Maintains misplaced (perfect 3) [] := by
  intro h
  have nesting := h.2
  simp [misplaced, chain, initial, perfect, MarkedTree.nesting, canonical, Wilber.labels] at nesting

example (reference : Tree) (past : List Nat) : Maintains (canonical reference 0 past) reference past :=
  canonical_maintains reference past

example : (canonical (perfect 2) 0 [0, 2]).region.keys 0 = {1, 2} := by decide

